# The browser uses /api/v1 by default; Next.js proxies it to this Go server.
API_PROXY_URL=http://127.0.0.1:8080

# Optional: use a directly accessible API instead of the same-origin proxy.
# Configure the Go server's CORS_ALLOWED_ORIGINS when using a separate origin.
# NEXT_PUBLIC_API_URL=https://api.example.com/api/v1
